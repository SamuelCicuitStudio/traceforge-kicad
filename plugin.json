{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.samuelcircuitstudio.traceforge",
  "name": "TraceForge",
  "description": "PCB signal-integrity and layout toolkit: live signal-chain timing through series parts, chain highlighting, signal-path export; via stitching and parallel routing planned",
  "runtime": {
    "type": "python",
    "min_version": "3.9"
  },
  "actions": [
    {
      "identifier": "traceforge-panel",
      "name": "TraceForge",
      "description": "Open the TraceForge panel: manual timing refresh, chain highlighting and zoom, DRC targets, export and shortcuts",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "traceforge_action.py",
      "icons-light": [
        "icons/traceforge-light-24.png",
        "icons/traceforge-light-48.png"
      ],
      "icons-dark": [
        "icons/traceforge-dark-24.png",
        "icons/traceforge-dark-48.png"
      ]
    },
    {
      "identifier": "signal-timing-monitor",
      "name": "TraceForge: Signal Timing Monitor",
      "description": "Live timing of signal chains through series resistors and chokes: totals, targets, pair skew, stubs, DRC targets",
      "show-button": false,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "net_chain_monitor_action.py",
      "icons-light": [
        "icons/signal-timing-monitor-light-24.png",
        "icons/signal-timing-monitor-light-48.png"
      ],
      "icons-dark": [
        "icons/signal-timing-monitor-dark-24.png",
        "icons/signal-timing-monitor-dark-48.png"
      ]
    },
    {
      "identifier": "highlight-signal-chain",
      "name": "TraceForge: Highlight Signal Chain",
      "description": "Select every net and series part of the signal chain containing the selected item",
      "show-button": false,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "highlight_net_chain_action.py",
      "icons-light": [
        "icons/highlight-signal-chain-light-24.png",
        "icons/highlight-signal-chain-light-48.png"
      ],
      "icons-dark": [
        "icons/highlight-signal-chain-dark-24.png",
        "icons/highlight-signal-chain-dark-48.png"
      ]
    },
    {
      "identifier": "export-signal-paths",
      "name": "TraceForge: Export Signal Paths",
      "description": "Export routed net lengths and estimated delays to CSV",
      "show-button": false,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "signal_path_analyzer_action.py",
      "icons-light": [
        "icons/export-signal-paths-light-24.png",
        "icons/export-signal-paths-light-48.png"
      ],
      "icons-dark": [
        "icons/export-signal-paths-dark-24.png",
        "icons/export-signal-paths-dark-48.png"
      ]
    }
  ]
}
